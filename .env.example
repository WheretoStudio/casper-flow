# Copy this file to .env and fill in your keys.
# Casper Flow reads .env on startup — no shell sourcing needed.
# Lines starting with # are ignored.

# ── OpenAI ────────────────────────────────────────────────────────────
# Used for: transcribe_backend=openai  AND/OR  llm_backend=openai
OPENAI_API_KEY=sk-...

# ── Groq ──────────────────────────────────────────────────────────────
# Used for: transcribe_backend=groq    AND/OR  llm_backend=groq
GROQ_API_KEY=gsk_...

# ── Anthropic (Claude) ────────────────────────────────────────────────
# Used for: llm_backend=anthropic
ANTHROPIC_API_KEY=sk-ant-...
