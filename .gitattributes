# Normalise line endings so the repository is consistent regardless of who
# clones it. Casper Flow is a Windows app, but the website is built on a Linux CI
# runner, so both sides have to agree.

# Default: normalise to LF in the repository, check out native on Windows.
* text=auto

# Explicitly LF, because these are read by tools that dislike CRLF.
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.txt   text eol=lf
*.ini   text eol=lf

# Windows script hosts want CRLF. A .bat with LF endings can fail in ways that
# are tedious to diagnose.
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Binary: never touch.
*.ico   binary
*.png   binary
*.jpg   binary
*.wav   binary
*.woff2 binary

# Generated by the TanStack Router plugin. Kept in the repository because the
# build needs it, but it is not worth reviewing in a diff.
website/src/routeTree.gen.ts linguist-generated=true

# Lock files are generated. Collapse them in review.
package-lock.json        linguist-generated=true
requirements.lock.txt    linguist-generated=true
